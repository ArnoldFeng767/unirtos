    bool "Enable ASR 160X platform support"

config QOSA_EIGEN718_PLATFORM_FUNC
    bool "Enable Eigen 718 platform support"

config QOSA_UIS8852_PLATFORM_FUNC
    bool "Enable Unisoc 8852 platform support"

config QOSA_QT2131_PLATFORM_FUNC
    bool "Enable QT2131 platform support"

