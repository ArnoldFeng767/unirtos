menu "UniRTOS system feature"

config QOSA_FEATURE_ALLOW_CHANGE
    bool
    default n

config QOSA_OPENCPU_FUNC
    bool "Enable OpenCPU function"
    default n

config QOSA_VFS_FILESYSTEM_FUNC
    bool "Enable Virtual file system"
    default y

config QOSA_LINK_LIST_FUNC
    bool "Enable Bidirectional linkedlist"
    default y

config QOSA_BUFFER_BLOCK_FUNC
    bool "Enable Data service manager"
    default y

config QOSA_SSL_FUNC
    bool "Enable SSL third-party library types"
    default y

config QOSA_SOCKET_DNS_FUNC
    bool "Enable synchronous and asynchronous DNS resolution"
    default n

config QOSA_EVENT_NOTIFY_FUNC
    bool "Enable registration notification function"
    default y

config QOSA_LOG_DEBUG_FUNC
    bool "Enable log printing and output function"
    default y

config QOSA_VSIM_ADAPT_FUNC
    bool "Enable vsim function"
    default n

config QOSA_DATACALL_FUNC
    bool "Enable PDP management function"
    select QOSA_EVENT_NOTIFY_FUNC
    select QOSA_LINK_LIST_FUNC
    default n

config QOSA_MODEM_DEV_FUNC
    bool "Enable modem-related management function"
    default n

config QOSA_NW_FUNC
    bool "Enable network parameter update and indication report function"
    depends on QOSA_LINK_LIST_FUNC
    default n

config QOSA_IMS_FUNC
    bool "Enable ims parameter update and indication report function"
    default n

config QOSA_USBNET_FUNC
    bool "Enable USBNET(ECM/RNDIS/NCM) function"
    default n

config QOSA_PPP_FUNC
    bool "Enable PPP function"
    default n

config QOSA_SIM_FUNC
    bool "Enable modem SIM/(U)SIM function"
    default n

config QOSA_SIM_HAL_SLOT_NUM
    int "sim card number" if QOSA_FEATURE_ALLOW_CHANGE
    default 1
    range 1 2
    help
        could be 1 or 2

config QOSA_SMS_FUNC
    bool "Enable modem SMS function"
    default n

config QOSA_VIRT_AT_FUNC
    bool "Enable virtual AT function"
    default n

config QOSA_DSDS_FUNC
    bool "Enable Dual-SIM Dual-Standby function"
    default n

# If using the built-in UniRTOS library, enable the MBEDTLS3_X_X or MBEDTLS2_X_X macro definition.
# If not using the built-in UniRTOS library and directly using the platform's native mbedtls library, do not select either.
# However, the OSA_MBEDTLS_LIBRARY_FUNC macro must also be enabled.
config QOSA_MBEDTLS_LIBRARY_FUNC
    bool "Enable mbedtls library types"
    depends on QOSA_SSL_FUNC
    default y

config QOSA_MBEDTLS3_X_X_LIBRARY_FUNC
    bool "Enable mbedtls3_x_x to support TLS1_3"
    depends on QOSA_SSL_FUNC
    depends on QOSA_MBEDTLS_LIBRARY_FUNC
    default n

config QOSA_MBEDTLS2_X_X_LIBRARY_FUNC
    bool "Enable mbedtls2_28_x to support TLS1_1 and TLS1_2"
    depends on QOSA_SSL_FUNC
    depends on QOSA_MBEDTLS_LIBRARY_FUNC
    default n

config QOSA_WATERMARK_FUNC
    bool "Enable watermark function"
    depends on QOSA_BUFFER_BLOCK_FUNC
    depends on QOSA_LINK_LIST_FUNC
    default y

config QOSA_LINK_SYSTEM_LIBRARIES_FUNC
    bool "Enable link system libraries function"
    default n

config QOSA_UDP_UART_FUNC
    bool "Enable linux udp uart function"
    depends on QOSA_LINUX_PLATFORM_FUNC
    default y

config QOSA_WIFISCAN_FUNC
    bool "Enable WIFISCAN function"
    default n

